# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env

# ---------------------------------------------------------------- obrigatório

# Senha do Postgres. Invente uma longa; ninguém precisa decorar.
# Para gerar uma no PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- opcional

POSTGRES_USER=hub
POSTGRES_DB=hub

# ---------------------------------------------------------------- endereço público
#
# Com DOMINIO preenchido, o proxy pede e renova o certificado HTTPS sozinho.
# O apontamento de DNS precisa estar feito ANTES de subir, senão o certificado falha.
# Deixe vazio para servir em http na porta 80 (teste local).
DOMINIO=
URL_PUBLICA=

# Porta da aplicação dentro do servidor, só para depuração local. O proxy é quem
# atende a internet, nas portas 80 e 443.
PORTA_LOCAL=3000

VERSAO=0.1.0
LOG_NIVEL=info

# Deixe false em teste por http. Com DOMINIO preenchido (HTTPS), mude para true:
# sem isso o cookie de sessão não volta e ninguém consegue entrar.
COOKIE_SEGURO=false

# ---------------------------------------------------------------- inteligência artificial
#
# Preencha a chave do provedor que for usar. O provedor em si é escolhido na
# etapa 2 da configuração, dentro do programa.
#
# Deixe LLM_MODE=stub para rodar o fluxo inteiro sem chamar API e sem gastar.
# Apague a linha (ou deixe vazia) para usar o provedor de verdade.
LLM_MODE=stub

CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Os modelos Llama costumam ser acessados por um intermediário compatível com o
# formato da OpenAI (Groq, Together, Bedrock), não por uma API própria da Meta.
META_API_KEY=

# ---------------------------------------------------------------- reiniciar o teste
#
# Senha do botão "Reiniciar teste" (barra de cima). Apaga as mentoradas, os módulos
# preenchidos, os documentos e as skills, e volta o assistente ao começo. Mantém a conta.
# Sem esta variável o botão fica desligado. Nunca escreva a senha no código.
SENHA_REINICIAR=
